[Unit]
Description=Provision Homebrew into /var on first boot
Wants=basic.target
After=basic.target
# Idempotence: skip entirely once brew exists, and do nothing if the image was
# built without the payload.
ConditionPathExists=!/home/linuxbrew/.linuxbrew
ConditionPathExists=/usr/share/homebrew.tar.zst

[Service]
Type=oneshot
RemainAfterExit=yes
# The Rust subcommand, not a shell wrapper -- see scorched-performance.service
# for why the bash original at /usr/libexec/scorched-brew-setup is gone rather
# than merely unused.
ExecStart=/usr/bin/scorched brew-setup

[Install]
WantedBy=default.target multi-user.target
