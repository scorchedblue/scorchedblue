[Unit]
Description=Set every CPU to performance mode
# Nothing to do on a machine with no cpufreq interface, which is the normal
# situation inside a VM. Without this the unit would run and report nothing.
ConditionPathIsDirectory=/sys/devices/system/cpu/cpu0/cpufreq
Wants=basic.target
After=basic.target

[Service]
Type=oneshot
# RemainAfterExit so `systemctl status` shows the setting as applied rather than
# as a process that exited, and so the unit reads as state rather than an event.
RemainAfterExit=yes
# The Rust subcommand, not a shell wrapper. The bash original lived at
# /usr/libexec/scorched-performance and is deleted: shipping both meant the
# tested implementation and the running one were different files, free to drift
# with nothing comparing them.
ExecStart=/usr/bin/scorched performance

[Install]
WantedBy=multi-user.target
